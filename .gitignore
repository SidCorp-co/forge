# Dependencies
node_modules

# Turborepo cache
.turbo

# pnpm store (project-local, if used)
.pnpm-store

# Build output
dist
build
out
.next
.cache
*.tsbuildinfo

# Test output
coverage
playwright-report
playwright/.cache
.playwright-mcp/
# Backstop: live-verify / clarify screenshot artifacts (convention is .playwright-mcp/
# above, but if an agent saves one to the repo root it must never dirty the worktree
# and block forge-test's clean-target merge gate). Anchored to root only.
/iss-*.png
/iss[0-9]*.png

# Core-driven per-issue checkouts (`<repo>/.worktrees/<ISS-n>`). Committed rather than left to
# the runner: it appends this line itself when it is missing, which would dirty the repo root on
# the first worktree job and make the next refresh read a tracked edit as someone's uncommitted work.
.worktrees

# The `forge` CLI's project marker, written into whatever directory it is run from. Local, not
# repo config: the slug pins this checkout to one Forge project, so committing it would ship
# `forge-dev` to every clone of a repo other projects also point at.
/.forge.json

# OS
.DS_Store
Thumbs.db
*Zone.Identifier
__pycache__
*.pyc
# `.claude/` is local-only working state — skills are distributed via the
# server (Skill Studio / device skill sync), not committed here. Ignore the
# contents (skills, worktrees, agents, settings, state, screenshots).
# `rules/` is the one exception: not a skill, but reviewed repo doctrine that must reach
# teammates and runner boxes the same way CLAUDE.md does. Ignore the contents rather than
# the directory — git does not descend into an ignored directory, so a `!` under `.claude/`
# would never be reached.
.claude/*
!.claude/rules/
.claude/rules/*
!.claude/rules/*.md
# `forge-master` is the ONE skill the runner binary embeds with `include_str!`, so it is source,
# not local config: untracked, the runner does not build from a clean clone. Only this skill is
# un-ignored — opening all of `.claude/skills/` would commit every skill a box happens to install.
!.claude/skills/
.claude/skills/*
!.claude/skills/forge-master/
.claude/skills/forge-master/*
!.claude/skills/forge-master/*.md

# IDE
.idea
.vscode
*.swp
*.swo
*~
*.orig
*.rej
*.bak

# Direnv (per-shell env)
.envrc

# Vite cache
*.timestamp-*

# Environment
.env
.env.*
!.env.example

# Local MCP client config (may contain API keys)
.mcp.json
!.mcp.json.example

# Logs
*.log

# Internal-only docs (maintainer artifacts: release tests, migration audits, ops runbooks)
.internal-docs/

# Claude Code files — root CLAUDE.md is committed (contributor guidance);
# per-package agent notes and personal/maintainer instructions stay local.
packages/*/CLAUDE.md
CLAUDE.local.md
# `next dev` regenerates packages/web-v2/AGENTS.md on every run (see
# next/dist/server/lib/generate-agent-files.js), and packages/web-v2/CLAUDE.md @-imports it —
# ignoring only the CLAUDE.md left an untracked file in the tree after any dev run.
packages/*/AGENTS.md

# Local-only scratch renders — the committed architecture lives in docs/proposals/
docs/local/
