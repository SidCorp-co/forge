# Flat node_modules, and NOT for disk: measured 2026-09-27, a worktree's node_modules holds 23.3 MB
# of blocks the pnpm store does not name under this setting and 36.3 MB without it, the gigabytes
# du reports being the store's own inodes reached by hardlink. It is here because four things
# resolve from the repository ROOT a package only @forge/core declares, and reach it only by
# hoisting: scripts/verify.mjs runs `pnpm exec biome check scripts` (@biomejs/biome);
# scripts/check-integration-declarations.mjs spawns the root's node_modules/.bin/tsx (tsx);
# .forge/archmap/src/providers/ts.mjs walks the root for its bin (dependency-cruiser); and
# .arch-tsconfig.json maps hono/* to node_modules/hono/dist/* (hono). Remove these two lines and
# `pnpm verify` loses five verdicts — form scripts lint goes red with `Command "biome" not found`,
# and relations archmap, form integration-declarations, meta conformance levels and meta
# conformance audit cannot run at all. Declaring those three tools at the root clears all five and
# leaves meta conformance audit R7 failing on 208 unresolvable edges against a ceiling of 50.
# Why it stays, what it costs and what it hides:
# docs/proposals/hoisting-is-kept-and-the-gigabytes-are-elsewhere.md
node-linker=hoisted
shamefully-hoist=true

# Auto-install peer dependencies (reduces friction during OSS contributor setup).
auto-install-peers=true

# Use the on-disk content-addressable store efficiently.
prefer-workspace-packages=true

# Fail fast on engines mismatch (we require Node >=20).
engine-strict=true
