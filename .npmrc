# Flat node_modules, and NOT for disk: measured 2026-09-27, a worktree's node_modules holds 23.3 MB
# of blocks the pnpm store does not name under this setting and 36.3 MB without it, the gigabytes
# du reports being the store's own inodes reached by hardlink. It is here because six packages are
# imported by code that does not declare them and reach a root that only hoisting puts them in:
# scripts/verify.mjs runs `pnpm exec biome check scripts` and scripts/check-lint-budget.mjs runs
# `npx biome` inside packages/web-v2, which declares no biome of its own (@biomejs/biome);
# scripts/check-integration-declarations.mjs spawns the root's node_modules/.bin/tsx (tsx);
# .forge/archmap/src/providers/ts.mjs walks the root for its bin (dependency-cruiser);
# .arch-tsconfig.json maps hono/* to node_modules/hono/dist/* (hono);
# scripts/check-lazy-module-init.mjs opens with `import ts from 'typescript'` (typescript); and
# packages/web-v2/src/vitest.setup.ts imports @testing-library/dom, which no manifest in this
# workspace declares at all — it arrives as a transitive of @testing-library/react.
# Remove these two lines and `pnpm verify` loses SEVEN verdicts: form scripts lint goes red with
# `Command "biome" not found`, form lazy-module-init goes red with ERR_MODULE_NOT_FOUND on
# typescript, and form lint-budget, form integration-declarations, relations archmap, meta
# conformance levels and meta conformance audit each report that they could not run. `pnpm build`
# and `pnpm test` both fail on web-v2 as well. `pnpm deploy --filter=@forge/core --prod`, the line
# packages/core/Dockerfile builds the production image with, is the one thing measured here that
# does NOT need hoisting.
# RE-MEASURE THIS OUTSIDE EVERY forge-core CHECKOUT — .claude/worktrees/ is INSIDE one, so node's
# upward walk leaves the worktree and finds the parent checkout's hoisted node_modules, and every
# failure above disappears. The first version of this comment said four packages and five verdicts
# because it was measured in a worktree, where the measurement could not fail.
# Why it stays, what it costs and what it hides:
# docs/proposals/hoisting-is-kept-and-the-gigabytes-are-elsewhere.md
node-linker=hoisted
shamefully-hoist=true

# Auto-install peer dependencies (reduces friction during OSS contributor setup).
auto-install-peers=true

# Resolve a dependency to the version in this workspace even when the registry has a higher one.
# It has nothing to do with the store: pnpm's resolver reads it in resolveFromLocalPackage, and the
# content-addressable store is used whatever it is set to.
prefer-workspace-packages=true

# Fail fast on engines mismatch (we require Node >=20).
engine-strict=true
