# Flat node_modules, and NOT for disk: measured 2026-09-27, a worktree's node_modules holds 23.3 MB
# of blocks the pnpm store does not name under this setting and 36.3 MB without it, the gigabytes
# du reports being the store's own inodes reached by hardlink. It is here because code reached
# packages its manifest did not declare. ISS-207 declared biome, tsx, typescript, vitest and postgres
# at the root and biome and @testing-library/dom in web-v2; what still needs a hoisted root is
# .arch-tsconfig.json mapping hono/* to node_modules/hono/dist/* (hono, declared by core only).
# Removing these two lines has not been re-measured since those declarations.
# RE-MEASURE THIS OUTSIDE EVERY forge-core CHECKOUT — .claude/worktrees/ is INSIDE one, so node's
# upward walk leaves the worktree and finds the parent checkout's hoisted node_modules, and every
# failure disappears.
# Why it stays, what it costs and what it hides:
# docs/proposals/hoisting-is-kept-and-the-gigabytes-are-elsewhere.md
node-linker=hoisted
shamefully-hoist=true

# Auto-install peer dependencies (reduces friction during OSS contributor setup).
auto-install-peers=true

# Resolve a dependency to the version in this workspace even when the registry has a higher one.
# It has nothing to do with the store: pnpm's resolver reads it in resolveFromLocalPackage, and the
# content-addressable store is used whatever it is set to.
prefer-workspace-packages=true

# Fail fast on engines mismatch (we require Node >=22.12, pg-boss 12's floor).
engine-strict=true
