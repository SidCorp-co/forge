{
  "name": "forge",
  "version": "0.4.0-dev.136",
  "private": true,
  "description": "Open-source control plane for Claude Code. Monorepo root.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build --concurrency=2",
    "lint": "turbo run lint",
    "test": "turbo run test --continue=always --concurrency=2",
    "test:changed": "node scripts/test-changed.mjs",
    "typecheck": "turbo run typecheck --concurrency=2",
    "tc:changed": "node scripts/tc-changed.mjs",
    "verify": "node scripts/verify.mjs",
    "check:memory": "node scripts/check-memory-anchors.mjs",
    "clean": "turbo run clean && rm -rf node_modules",
    "postinstall": "git config core.hooksPath .githooks 2>/dev/null || true",
    "images": "node scripts/build-images.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "dependency-cruiser": "18.2.0",
    "eslint": "^10.12.0",
    "postgres": "^3.4.9",
    "tsx": "^4.23.15",
    "turbo": "^2.11.6",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "overrides": {
      "nanoid@3": ">=3.3.18 <4",
      "esbuild": ">=0.25.0 <0.28.0 || >=0.28.1"
    }
  },
  "engines": {
    "node": ">=22.12",
    "pnpm": ">=9"
  }
}
