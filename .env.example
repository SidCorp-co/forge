# Database
POSTGRES_PASSWORD=forge_secret

# Core API (packages/core) — required
# Generate strong values: openssl rand -base64 32
JWT_SECRET=
DEVICE_TOKEN_PEPPER=
CORS_ORIGINS=http://localhost:3000
APP_BASE_URL=http://localhost:3000
# Public origin of the core API, used by forge_uploads to build absolute
# presigned upload URLs. Leave empty to return relative uploadPath only.
PUBLIC_API_BASE_URL=

# Core API — SMTP (required by core env schema; leave blank for dev if unused)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Local dev without a real mailbox: print the email-verification link to the
# container logs instead of sending it. This is the documented way past the
# verification wall in docs/quickstart.md — leave unset/false anywhere real.
SMTP_DEBUG=

# Web
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# Scripts & dev tooling
# FORGE_API_KEY: project-scoped key sent as X-Forge-API-Key header
FORGE_API_KEY=

# AI / embeddings (optional). Two INDEPENDENT settings that happen to be able to
# point at the same proxy — LITELLM_* drives chat and the system-job fast model
# (memory-v2 extraction/consolidation, auto-titling); EMBEDDINGS_* drives memory
# indexing and semantic search. Setting only LITELLM_* leaves memory writing
# keyword-only rows forever, and that degradation is deliberately silent.
# The proxy HOST (https://litellm.example.com); a trailing /v1 is tolerated. Model ids are
# whatever the proxy lists — a prefixed proxy needs e.g. LITELLM_MODEL=gm/gemini-2.5-flash.
LITELLM_API_URL=
LITELLM_API_KEY=
LITELLM_MODEL=
# Estimated-token cap on each chat request (default 80000, sized for a 128k
# model; raise on a 1M-context model). Older history, then older tool results,
# are elided to fit and the model is told what it can no longer see.
CHAT_CONTEXT_BUDGET_TOKENS=
# Anthropic Messages-wire chat adapter (optional). Selected per project via
# app_config.chat_provider_id; it is the default whenever ANTHROPIC_API_KEY is set.
# URL is the host (the adapter appends /v1/messages).
ANTHROPIC_API_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_MAX_TOKENS=
# EMBEDDINGS_BASE_URL is the /v1 root; the client POSTs {base}/embeddings.
# EMBEDDINGS_DIM must match the memories.embedding pgvector column (1536) —
# core refuses to boot on a mismatch rather than writing unsearchable rows.
EMBEDDINGS_BASE_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=
EMBEDDINGS_DIM=
# Per-call timeout (default 10000); a cold upstream model can take longer on first use.
EMBEDDINGS_TIMEOUT_MS=

# Optional Sentry telemetry (opt-in). Empty = SDK no-op (no events sent).
# Two distinct DSNs because docker-compose interpolation can't pass per-
# service overrides via a single SENTRY_DSN var — core needs the forge-
# core project, web needs the forge-web project.
#   - SENTRY_DSN_CORE: Hono backend (5xx + unhandled errors)
#   - SENTRY_DSN_WEB:  Next.js client (browser errors) AND server (SSR
#                      errors via onRequestError); same DSN both surfaces.
SENTRY_DSN_CORE=
SENTRY_DSN_WEB=

# ISS-234 — AES-256-GCM master key for the integration framework's
# CredentialVault. Generate with: openssl rand -base64 32
# Optional. The vault refuses to boot if this is missing AND any active row
# exists in project_integrations; fresh installs without integrations stay
# bootable without it.
INTEGRATION_MASTER_KEY=

# ISS-387 — Epodsystem integration (fixed service-to-service host config; NOT
# per-store, NOT user-supplied). An operator only pastes the crmk_ key per
# project; these hosts default to production and rarely change.
#   EPODSYSTEM_ENDPOINT: GraphQL/admin host for the healthcheck (apiKeyContext).
#                        Default: https://admin.epodsystem.com
#   EPODSYSTEM_MCP_URL:  shop MCP server injected into the runner.
#                        Default: https://mcp.epodsystem.com/mcp
EPODSYSTEM_ENDPOINT=https://admin.epodsystem.com
EPODSYSTEM_MCP_URL=https://mcp.epodsystem.com/mcp
