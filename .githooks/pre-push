#!/bin/bash
# pre-push hook — cheap guards only. CI (`ci-passed` aggregate check) is the
# AUTHORITATIVE merge gate; this hook just catches obvious mistakes fast and
# stays out of the way.
#
# Default behavior:
#   - branch-name check (ADR 0014)  → WARN only, never blocks
#   - package builds/tests          → SKIPPED
#
# Controls:
#   PREPUSH_BUILD=1 git push   — also build affected packages
#   PREPUSH_TEST=1  git push   — typecheck + the direct tests of what changed
#                                (`pnpm test:changed`, REQ-36 BC-7), never a whole suite
#   SKIP_PREPUSH=1  git push   — skip everything

set -e

if [ "$SKIP_PREPUSH" = "1" ]; then
  echo "[pre-push] SKIP_PREPUSH=1 — skipping all checks"
  exit 0
fi

# Capture stdin once — git only writes the ref list to the hook's stdin once.
stdin_input="$(cat)"
repo_root=$(git rev-parse --show-toplevel 2>/dev/null)

# Branch name per ADR 0014 — advisory. The pipeline generates compliant names
# itself and CI gates the merge, so a human/owner push is never blocked on
# naming.
if [ -x "$repo_root/scripts/check-branch-name.sh" ]; then
  while read -r local_ref _ _ _; do
    case "$local_ref" in
      refs/heads/*)
        branch="${local_ref#refs/heads/}"
        if ! "$repo_root/scripts/check-branch-name.sh" "$branch" >/dev/null 2>&1; then
          echo "[pre-push] WARN: branch '$branch' violates ADR 0014 naming — push continues (pipeline-tracked branches need ISS-<seq>-<slug>)"
        fi
        ;;
    esac
  done <<< "$stdin_input"
fi

if [ -n "$PREPUSH_FULL" ]; then
  echo "[pre-push] PREPUSH_FULL ran whole package suites and is gone (ISS-472): PREPUSH_TEST=1 runs the typecheck and the direct tests of what changed"
  exit 1
fi

if [ "$PREPUSH_TEST" = "1" ]; then
  # test:changed exits 1 when a check it ran is red, 2 when it could not run at all (a base it
  # cannot derive, a bad argument): the two are different news, and the second ran nothing.
  set +e
  (cd "$repo_root" && pnpm test:changed)
  status=$?
  set -e
  if [ "$status" = "1" ]; then
    echo "[pre-push] FAIL: the typecheck or a direct test is red. Push aborted."
    exit 1
  elif [ "$status" != "0" ]; then
    echo "[pre-push] FAIL: test:changed could not run (exit $status, the reason is above), so nothing was typechecked or tested. Push aborted."
    exit 1
  fi
fi

if [ "$PREPUSH_BUILD" != "1" ]; then
  echo "[pre-push] cheap guards passed — builds skipped (CI gates; PREPUSH_BUILD=1 to build, PREPUSH_TEST=1 for the direct tests)"
  exit 0
fi

# ---- opt-in build/test path ------------------------------------------------

# Read pushed refs from the captured stdin (format:
# <local-ref> <local-sha> <remote-ref> <remote-sha>)
# A new branch is measured from the branch it lands on, derived as every gate derives it
# (scripts/lib/base-branch.mjs), never from a local `main` that need not exist or be the target.
# Where none resolves, or the merge base cannot be read, the build is refused by name: diffing the
# commit against the working tree instead measures nothing and builds nothing, in silence.
range=""
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
    continue # branch deletion
  fi
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    target_ref=$(cd "$repo_root" && node --input-type=module -e "
      import { baseRef } from './scripts/lib/base-branch.mjs';
      const t = baseRef(process.cwd());
      if (t.refusal) { console.error(t.refusal); process.exit(2); }
      console.log(t.ref);
    ") || {
      echo "[pre-push] FAIL: PREPUSH_BUILD has no branch to measure the new branch ${local_ref#refs/heads/} against (the reason is above), so nothing was built. Push aborted."
      exit 1
    }
    base=$(git merge-base "$local_sha" "$target_ref") || {
      echo "[pre-push] FAIL: PREPUSH_BUILD could not read the merge base of $local_sha and $target_ref, so nothing was built. Push aborted."
      exit 1
    }
    range="$range $base..$local_sha"
  else
    range="$range $remote_sha..$local_sha"
  fi
done <<< "$stdin_input"

if [ -z "$range" ]; then
  echo "[pre-push] no commits to validate"
  exit 0
fi

changed=$(git diff --name-only $range) || {
  echo "[pre-push] FAIL: PREPUSH_BUILD could not diff$range, so nothing was built. Push aborted."
  exit 1
}
changed=$(echo "$changed" | sort -u)

if [ -z "$changed" ]; then
  echo "[pre-push] no file changes in pushed commits"
  exit 0
fi

packages=""
echo "$changed" | grep -q '^packages/core/' && packages="$packages core"
echo "$changed" | grep -q '^packages/web-v2/' && packages="$packages web-v2"
echo "$changed" | grep -q '^packages/contracts/' && packages="$packages contracts"

if [ -z "$packages" ]; then
  echo "[pre-push] no source-package files changed — nothing to build"
  exit 0
fi

echo "[pre-push] validating packages:$packages"

for pkg in $packages; do
  pkg_dir="$repo_root/packages/$pkg"
  if [ ! -d "$pkg_dir" ]; then
    echo "[pre-push] skip $pkg — directory missing"
    continue
  fi
  echo "[pre-push] $pkg → pnpm build (with workspace deps prebuilt)"
  # Emit-only workspace deps (e.g. @forge/observability → dist/) must build
  # before any consumer, or the consumer's import resolves to a missing file.
  if [ -d "$repo_root/packages/observability" ]; then
    (cd "$repo_root" && pnpm --filter @forge/observability build) || {
      echo "[pre-push] FAIL: @forge/observability build broke (consumer of $pkg)."
      exit 1
    }
  fi
  (cd "$pkg_dir" && pnpm build) || {
    echo "[pre-push] FAIL: $pkg build broke. Push aborted."
    exit 1
  }
done

echo "[pre-push] all checks passed for:$packages"
exit 0
