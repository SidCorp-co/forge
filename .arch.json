      "**/*.test.tsx",
      "**/tests/**",
      "**/__tests__/**"
    ],
    "relax": [
      "boundary",
      "forbidden"
    ]
  },
  "generated": {
    "globs": [
      "**/*.gen.ts",
      "**/*.generated.*",
      "**/drizzle/**"
    ]
  },
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.next/**",
    "**/.turbo/**",
    "**/coverage/**",
    "**/.forge/**",
    "**/.claude/**",
    "**/*.d.ts",
    "packages/web-v2/**",
    "packages/tests/**",
    "packages/web/**",
    "packages/runner/**",
    "packages/observability/**",
    "packages/contracts/**"
  ],
  "contracts": [
    {
      "id": "branches-is-pure",
      "type": "forbidden",
      "from": "core-branches",
      "to": "*",
      "status": "locked",
      "description": "branch naming and lookup answers from its inputs alone Measured: 0 outgoing cross-module edges today."
    },
    {
      "id": "config-is-pure",
      "type": "forbidden",
      "from": "core-config",
      "to": "*",
      "status": "locked",
      "description": "app config is read by 22 modules and must not reach back into any of them Measured: 0 outgoing cross-module edges today."
    },
    {
      "id": "install-is-pure",
      "type": "forbidden",
      "from": "core-install",
      "to": "*",
      "status": "locked",
      "description": "install describes a target; reaching outward would make it a second dispatcher Measured: 0 outgoing cross-module edges today."
    },
    {
      "id": "plugins-is-pure",
      "type": "forbidden",
      "from": "core-plugins",
      "to": "*",
      "status": "locked",
      "description": "plugin registry resolves by name only Measured: 0 outgoing cross-module edges today."
    },
    {
      "id": "no-coordinator-blob",
      "type": "fan-out",
      "scope": "file",
      "max_modules": 6,
      "status": "draft",
      "description": "Threshold from the measured distribution: 480 of 530 source files reach 1-3 modules; 6 leaves the 11 real outliers visible without flagging ordinary route files."
    }
  ]
}
