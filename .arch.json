  "tests": {
    "globs": [
      "**/*.test.ts",
      "**/*.test.tsx",
      "**/tests/**",
      "**/__tests__/**"
    ],
    "relax": [
      "boundary",
      "forbidden"
    ]
  },
  "generated": {
    "globs": [
      "**/*.gen.ts",
      "**/*.generated.*",
      "**/drizzle/**"
    ]
  },
  "exclude": [
    "**/node_modules/**",
    "**/.worktrees/**",
    "**/dist/**",
    "**/build/**",
    "**/.next/**",
    "**/.turbo/**",
    "**/coverage/**",
    "**/.forge/**",
    "**/.claude/**",
    "**/*.d.ts",
    "packages/runner/**",
    "packages/observability/**",
    "packages/contracts/**",
    "packages/core/src/index.ts",
    "packages/core/src/route-registry.ts",
    "packages/core/src/work-ports.ts",
    "packages/core/src/execution-ports.ts",
    "packages/core/src/integration-registry.ts",
    "packages/core/src/timer-registry.ts",
    "packages/core/src/outbox-consumers.ts"
  ],
  "contracts": [
    {
      "id": "branches-is-pure",
      "type": "forbidden",
      "from": "core-branches",
      "to": "*",
      "status": "locked",
      "description": "branch naming and lookup answers from its inputs alone Measured: 0 outgoing cross-module edges today."
    },
    {
      "id": "config-is-pure",
      "type": "forbidden",
      "from": "core-config",
      "to": "*",
      "status": "locked",
      "description": "app config is read by 22 modules and must not reach back into any of them Measured: 0 outgoing cross-module edges today."
    },
    {
      "id": "install-is-pure",
      "type": "forbidden",
      "from": "core-install",
      "to": "*",
      "status": "locked",
      "description": "install describes a target; reaching outward would make it a second dispatcher Measured: 0 outgoing cross-module edges today."
    },
    {
      "id": "plugins-is-pure",
      "type": "forbidden",
      "from": "core-plugins",
      "to": "*",
      "status": "locked",
      "description": "plugin registry resolves by name only Measured: 0 outgoing cross-module edges today."
    },
    {
      "id": "no-coordinator-blob",
      "type": "fan-out",
      "scope": "file",
      "max_modules": 6,
      "status": "locked",
      "description": "Threshold from the measured distribution: 480 of 530 source files reach 1-3 modules; 6 leaves the 11 real outliers visible without flagging ordinary route files. The composition roots (packages/core/src/index.ts, route-registry, work-ports, execution-ports, integration-registry, timer-registry, outbox-consumers) are excluded by name: each exists to wire every module at boot, so their fan-out is their purpose, not a blob; a file that is not a composition root is still held to 6 (ISS-225)."
    },
    {
      "id": "web-design-is-presentational",
      "type": "forbidden",
      "from": "web-design",
      "to": "web-features",
      "status": "locked",
      "description": "the kit renders what a feature hands it; a kit component reaching into a feature makes the kit un-reusable and the feature un-testable. Measured 2026-08-23 on the alias-resolved graph: 0 edges."
    },
    {
      "id": "web-design-holds-no-api-client",
      "type": "forbidden",
      "from": "web-design",
      "to": "web-lib-api",
      "status": "locked",
      "description": "a kit component renders what it is handed; resolving a URL against the API client makes the kit depend on a deploy's origin. Measured 2026-08-23: 0 edges, once `coreFileUrl` moved out of lib/api/client.ts to lib/utils/core-url.ts — it is a string function over one env value and was never part of the client."
    },
    {
      "id": "web-features-do-not-reach-into-routes",
      "type": "forbidden",
      "from": "web-features",
      "to": "web-app",
      "status": "locked",
      "description": "routes compose features, never the reverse; a feature importing a route file pins it to one URL. Same alias blindness as web-design-is-presentational. Measured 2026-08-23 on the alias-resolved graph: 0 edges."
    }
  ]
}
