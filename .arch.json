    "packages/contracts/**",
    "packages/core/src/index.ts",
    "packages/core/src/route-registry.ts",
    "packages/core/src/work-ports.ts",
    "packages/core/src/execution-ports.ts",
    "packages/core/src/integration-registry.ts",
    "packages/core/src/timer-registry.ts",
    "packages/core/src/outbox-consumers.ts",
    "packages/web-v2/src/app/(workspace)/layout.tsx",
    "packages/web-v2/src/app/(workspace)/projects/[slug]/page.tsx"
  ],
  "contracts": [
    {
      "id": "config-is-pure",
      "type": "forbidden",
      "from": "core-config",
      "to": "*",
      "status": "locked",
      "description": "app config is read by 22 modules and must not reach back into any of them Measured: 0 outgoing cross-module edges today."
    },
    {
      "id": "install-is-pure",
      "type": "forbidden",
      "from": "core-install",
      "to": "*",
      "status": "locked",
      "description": "install describes a target; reaching outward would make it a second dispatcher Measured: 0 outgoing cross-module edges today."
    },
    {
      "id": "no-coordinator-blob",
      "type": "fan-out",
      "scope": "file",
      "max_modules": 6,
      "status": "locked",
      "description": "Threshold from the measured distribution: 480 of 530 source files reach 1-3 modules; 6 leaves the 11 real outliers visible without flagging ordinary route files. The composition roots (packages/core/src/index.ts, route-registry, work-ports, execution-ports, integration-registry, timer-registry, outbox-consumers) are excluded by name: each exists to wire every module at boot, so their fan-out is their purpose, not a blob. So are web-v2's two route composition roots, `app/(workspace)/layout.tsx` and `app/(workspace)/projects/[slug]/page.tsx`, which compose the features once each feature is its own module (TD-S1); a file that is not a composition root is still held to 6 (ISS-225)."
    },
    {
      "id": "web-design-is-presentational",
      "type": "forbidden",
      "from": "web-design",
      "to": [
        "packages/web-v2/src/features/**"
      ],
      "status": "locked",
      "description": "the kit renders what a feature hands it; a kit component reaching into a feature makes the kit un-reusable and the feature un-testable. Measured 2026-08-23 on the alias-resolved graph: 0 edges."
    },
    {
      "id": "web-design-holds-no-api-client",
      "type": "forbidden",
      "from": "web-design",
      "to": "web-lib-api",
      "status": "locked",
      "description": "a kit component renders what it is handed; resolving a URL against the API client makes the kit depend on a deploy's origin. Measured 2026-08-23: 0 edges, once `coreFileUrl` moved out of lib/api/client.ts to lib/utils/core-url.ts — it is a string function over one env value and was never part of the client."
    },
    {
      "id": "web-features-do-not-reach-into-routes",
      "type": "layers",
      "order": [
        "web-app",
        "web-feature-settings",
        "web-feature-shell",
        "web-feature-version",
        "web-feature-project-dashboard",
        "web-feature-pairing",
        "web-feature-overview",
        "web-feature-operator",
        "web-feature-notifications",
        "web-feature-guides",
        "web-feature-docs",
        "web-feature-development",
        "web-feature-conversations",
        "web-feature-requirements",
        "web-feature-session",
        "web-feature-pipeline",
        "web-feature-contracts",
        "web-feature-automation",
        "web-feature-auth",
        "web-feature-attention",
        "web-feature-ecosystem",
        "web-feature-needs-you",
        "web-feature-agents",
        "web-feature-sessions",
        "web-feature-issues",
        "web-feature-modules",
        "web-feature-workflows",
        "web-feature-comments",
        "web-feature-feedback",
        "web-feature-suggestions",
        "web-feature-mockups",
        "web-feature-board",
        "web-feature-chat",
        "web-feature-releases",
        "web-feature-questions",
        "web-feature-project-settings",
        "web-feature-integrations",
        "web-feature-runners",
        "web-feature-project-config",
        "web-feature-run-control",
        "web-feature-agent-accounts",
        "web-feature-projects",
        "web-feature-onboarding",
        "web-feature-chat-dock",
        "web-feature-orgs",
        "web-feature-preferences",
        "web-feature-forecast",
        "web-features"
      ],
      "status": "locked",
      "description": "routes compose features, never the reverse, and features import one another one way only: a feature may depend on features later in this order, never earlier, so no two features can import each other (TD-S1 made the 18 two-way pairs one-way). The order is the measured topological order of the feature import graph; moving a feature is allowed only where the move leaves the graph acyclic. `web-features` (last) holds a feature directory not yet declared here, which may depend on no declared feature until it is given its own module."
    }
  ]
}
