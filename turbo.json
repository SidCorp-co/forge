{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "globalDependencies": ["**/.env", "**/.env.local", "**/.env.*.local"],
  "globalPassThroughEnv": ["FORGE_API", "FORGE_PAT"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.test.ts", "!**/*.test.tsx", "!tests/**"],
      "outputs": ["dist/**", "build/**"],
      "env": ["NODE_ENV"]
    },
    "@forge/contracts#build": {
      "dependsOn": [],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.test.ts"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/**"]
    },
    "typecheck": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/contracts/src/**",
        "$TURBO_ROOT$/packages/core/src/**",
        "$TURBO_ROOT$/packages/observability/src/**",
        "!$TURBO_ROOT$/packages/**/*.test.ts",
        "!$TURBO_ROOT$/packages/**/*.test.tsx",
        "!tests/**"
      ],
      "outputs": ["node_modules/.cache/tsc/typecheck.tsbuildinfo"]
    },
    "typecheck:test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/contracts/src/**",
        "$TURBO_ROOT$/packages/core/src/**",
        "$TURBO_ROOT$/packages/observability/src/**"
      ],
      "outputs": ["node_modules/.cache/tsc/test.tsbuildinfo"]
    },
    "clean": {
      "cache": false
    }
  }
}
