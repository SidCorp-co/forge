{
  "name": "@forge/contracts",
  "version": "0.3.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Shared TypeScript types + request schemas derived from @forge/core (Drizzle rows + Zod schemas). Type-only surface \u2014 no runtime coupling.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./failure-causes": {
      "types": "./src/failure-causes.ts",
      "default": "./src/failure-causes.ts"
    },
    "./pipeline-registry": {
      "types": "./src/pipeline-registry.ts",
      "default": "./src/pipeline-registry.ts"
    },
    "./issue-vocabulary": {
      "types": "./src/issue-vocabulary.ts",
      "default": "./src/issue-vocabulary.ts"
    },
    "./notifications": {
      "types": "./src/notifications.ts",
      "default": "./src/notifications.ts"
    },
    "./attachments": {
      "types": "./src/attachments.ts",
      "default": "./src/attachments.ts"
    },
    "./deploy-capability": {
      "types": "./src/deploy-capability.ts",
      "default": "./src/deploy-capability.ts"
    },
    "./status-sets": {
      "types": "./src/status-sets.ts",
      "default": "./src/status-sets.ts"
    },
    "./document-patch": {
      "types": "./dist/document-patch.d.ts",
      "default": "./dist/document-patch.js"
    }
  },
  "types": "./src/index.ts",
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@forge/core": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.emit.json && tsc --noEmit -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
