{
  "name": "@forge/contracts",
  "version": "0.3.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Shared TypeScript types, registries and Zod schemas that clients and @forge/core read alike. Core's own shapes are imported as types only; the constants and schemas shipped here declare their own values.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./failure-causes": {
      "types": "./src/failure-causes.ts",
      "default": "./src/failure-causes.ts"
    },
    "./pipeline-registry": {
      "types": "./src/pipeline-registry.ts",
      "default": "./src/pipeline-registry.ts"
    },
    "./issue-vocabulary": {
      "types": "./src/issue-vocabulary.ts",
      "default": "./src/issue-vocabulary.ts"
    },
    "./notifications": {
      "types": "./src/notifications.ts",
      "default": "./src/notifications.ts"
    },
    "./attachments": {
      "types": "./dist/attachments.d.ts",
      "default": "./dist/attachments.js"
    },
    "./mark-merged-words": {
      "types": "./dist/mark-merged-words.d.ts",
      "default": "./dist/mark-merged-words.js"
    },
    "./health-words": {
      "types": "./dist/health-words.d.ts",
      "default": "./dist/health-words.js"
    },
    "./stuck-words": {
      "types": "./dist/stuck-words.d.ts",
      "default": "./dist/stuck-words.js"
    },
    "./deploy-capability": {
      "types": "./src/deploy-capability.ts",
      "default": "./src/deploy-capability.ts"
    },
    "./status-sets": {
      "types": "./src/status-sets.ts",
      "default": "./src/status-sets.ts"
    },
    "./work-state": {
      "types": "./src/work-state.ts",
      "default": "./src/work-state.ts"
    },
    "./test-credentials": {
      "types": "./src/test-credentials.ts",
      "default": "./src/test-credentials.ts"
    },
    "./document-patch": {
      "types": "./dist/document-patch.d.ts",
      "default": "./dist/document-patch.js"
    }
  },
  "types": "./src/index.ts",
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@forge/core": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "^5.0.4"
  },
  "scripts": {
    "build": "tsc -p tsconfig.emit.json && tsc --noEmit -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
