{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/tsc/typecheck.tsbuildinfo",
    "paths": {
      "@forge/contracts": ["../contracts/src/index.ts"],
      "@forge/contracts/*": ["../contracts/src/*"],
      "@forge/core/public": ["../core/src/public.ts"],
      "@forge/core/admin-types": ["../core/src/admin/types.ts"],
      "@forge/observability": ["../observability/src/index.ts"]
    }
  },
  "include": ["src/**/*"]
}
