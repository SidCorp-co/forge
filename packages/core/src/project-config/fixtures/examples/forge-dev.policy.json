{
  "$schema": "https://forge.sidcorp.co/schemas/policy-v1.json",
  "version": 1,
  "qa": "independent",
  "intake": { "mode": "auto" },
  "permissions": {
    "development": {
      "deny": [
        "mcp__forge__forge_projects_create",
        "mcp__forge__forge_projects_update",
        "mcp__forge__forge_orgs_list",
        "mcp__forge__forge_orgs_members",
        "mcp__forge__forge_collaborators",
        "mcp__forge__forge_runners",
        "mcp__forge__forge_jobs_cancel",
        "mcp__forge__forge_skills_create",
        "mcp__forge__forge_skills_update",
        "mcp__forge__forge_skills_delete",
        "mcp__forge__forge_memory_write",
        "mcp__forge__forge_memory_delete",
        "Bash(git push --force:*)",
        "CronCreate",
        "CronDelete",
        "CronList",
        "Workflow",
        "RemoteTrigger",
        "ScheduleWakeup"
      ]
    }
  },
  "states": {
    "open": { "model": "opus", "permissions": "development" },
    "in_progress": { "model": "opus", "permissions": "development" }
  }
}
