{
  "$schema": "https://forge.sidcorp.co/schemas/project-v1.json",
  "version": 1,
  "project": {
    "id": "da368b0a-8e21-4763-9d90-8f7b9d0c7115",
    "slug": "forge-dev",
    "name": "Forge Dev"
  },
  "source": {
    "type": "git",
    "git": {
      "repository": "github.com/SidCorp-co/forge",
      "defaultBranch": "main",
      "branches": ["main"]
    }
  },
  "workspace": {
    "isolation": "worktree",
    "setup": "pnpm install"
  },
  "validation": {
    "gate": {
      "type": "github-check",
      "name": "ci-passed"
    }
  },
  "environments": {
    "live": {
      "tier": "production",
      "deploysFrom": "main",
      "deployment": {
        "binding": "3f1c2a9e-7b4d-4e21-9c1a-5d6e7f8a9b0c",
        "trigger": "on-land"
      },
      "url": "https://forge-beta.sidcorp.co",
      "services": {
        "api": "https://forge-beta-api.sidcorp.co"
      },
      "verification": {
        "runtime": [
          {
            "type": "http",
            "url": "https://forge-beta-api.sidcorp.co/version",
            "path": "sourceCommit",
            "identifies": "source"
          }
        ]
      },
      "testing": "forge-beta"
    }
  },
  "promotions": [],
  "rollback": {
    "strategy": "revert-and-redeploy"
  },
  "execution": {
    "plugin": {
      "source": "SidCorp-co/forge-plugin",
      "ref": "73225dedb41b5da26b4ce73518086e26e81f91b8"
    }
  }
}
