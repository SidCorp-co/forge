{
  "name": "@forge/core",
  "version": "0.3.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Forge core API — Hono + Drizzle (RFC 0002 Strapi replacement).",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./public": {
      "types": "./src/public.ts",
      "default": "./dist/public.js"
    },
    "./admin-types": {
      "types": "./src/admin/types.ts",
      "default": "./dist/admin/types.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "drizzle",
    "public"
  ],
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --coverage.reporter=json --coverage.reportsDirectory=coverage/unit",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:ci": "TEST_DB_MODE=container vitest run --config vitest.integration.config.ts",
    "test:integration:coverage": "vitest run --config vitest.integration.config.ts --coverage --coverage.reporter=json --coverage.reportsDirectory=coverage/integration",
    "lint": "biome check src tests --max-diagnostics=none",
    "lint:fix": "biome check --write src tests",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@forge/observability": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@sentry/node": "^10.70.0",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "argon2": "^0.45.1",
    "cron-parser": "^5.10.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.3",
    "jose": "^6.2.9",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "pg-boss": "^12.30.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@forge/contracts": "workspace:*",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^26.4.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^5.0.0",
    "dependency-cruiser": "^18",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "testcontainers": "^12.1.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
