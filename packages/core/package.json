{
  "name": "@forge/core",
  "version": "0.4.0-dev.117",
  "private": true,
  "license": "Apache-2.0",
  "description": "Forge core API — Hono + Drizzle (RFC 0002 Strapi replacement).",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./public": {
      "types": "./src/public.ts",
      "default": "./dist/public.js"
    },
    "./admin-types": {
      "types": "./src/admin/types.ts",
      "default": "./dist/admin/types.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "drizzle",
    "public"
  ],
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json --noCheck && node dist/whats-new/check-changelog.js",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:integration": "turbo run build --filter=@forge/core^... --output-logs=errors-only && vitest run --config vitest.integration.config.ts",
    "test:integration:ci": "vitest run --config vitest.integration.config.ts",
    "lint": "biome check src tests --max-diagnostics=none",
    "lint:fix": "biome check --write src tests",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "contracts:generate": "tsx src/contracts-generate.ts",
    "oasdiff:fetch": "tsx src/ecosystem/contract/oasdiff-fetch.ts node_modules/.cache/oasdiff",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.72",
    "@ai-sdk/openai-compatible": "^3.0.63",
    "@forge/contracts": "workspace:*",
    "@forge/observability": "workspace:*",
    "@graphql-inspector/core": "^8.0.0",
    "@hono/node-server": "^2.1.3",
    "@hono/zod-validator": "^0.9.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@octokit/auth-app": "^8.3.1",
    "@octokit/core": "^7.0.8",
    "@octokit/plugin-retry": "^8.1.1",
    "@octokit/plugin-throttling": "^11.0.5",
    "@sentry/node": "^10.70.0",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "ai": "^7.0.128",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "argon2": "^0.45.1",
    "cron-parser": "^5.10.1",
    "drizzle-orm": "^0.45.3",
    "forge-plugin": "https://codeload.github.com/SidCorp-co/forge-plugin/tar.gz/2f3f40e245dd79c416f1abdbdd52e6487c632b97",
    "graphql": "^16.14.2",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "nodemailer": "^10.0.15",
    "openid-client": "^6.8.8",
    "pg": "^8.23.1",
    "pg-boss": "^12.37.0",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "rate-limiter-flexible": "^11.2.1",
    "re2js": "2.8.6",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.3",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "testcontainers": "^12.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.12"
  }
}
