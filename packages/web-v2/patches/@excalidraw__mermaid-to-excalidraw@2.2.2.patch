+// Mermaid 11.14 prefixes every internal element id of a rendered diagram (nodes, edges, clusters,
+// markers) with the SVG's own id: `<renderId>-classId-Issue-0`, `<renderId>-entity-ISSUE-0`. The
+// parsers below look elements up by the bare ids the diagram's db holds, as mermaid rendered them
+// before 11.14, and fail on the prefixed ones (forge ISS-911). Strip the prefix for the parse and
+// hand back a function that puts every id back, so an SVG kept as the image fallback still resolves
+// its own `url(#...)` references.
+const unprefixRenderIds = (svgContainer, renderId) => {
+    const prefix = `${renderId}-`;
+    const renamed = Array.from(svgContainer.querySelectorAll("[id]")).filter((el) => el.id.startsWith(prefix));
+    renamed.forEach((el) => {
+        el.id = el.id.slice(prefix.length);
+    });
+    let restored = false;
+    return () => {
+        if (restored) {
+            return;
+        }
+        restored = true;
+        renamed.forEach((el) => {
+            el.id = `${prefix}${el.id}`;
+        });
+    };
+};
 // Fallback to Svg
