{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "types": ["vite/client"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/tsc/typecheck.tsbuildinfo",
    "paths": {
      "@/*": ["./src/*"],
      "@forge/contracts/*": ["../contracts/src/*"],
      "@forge/core/public": ["../core/src/public.ts"],
      "@forge/core/admin-types": ["../core/src/admin/types.ts"],
      "@forge/observability": ["../observability/src/index.ts"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.test.tsx",
    "src/test/**",
    "src/vitest.setup.ts",
    "vitest.config.ts",
    "witness/**"
  ]
}
